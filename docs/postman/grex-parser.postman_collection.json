{
  "info": {
    "name": "Grex Parser API",
    "description": "Публичный REST API Grex Parser: парсинг карточек товаров с маркетплейсов.\n\n1. Импортируйте коллекцию и окружение «Grex Parser — Local».\n2. В переменной baseUrl укажите адрес сервера.\n3. В переменную apiKey вставьте API-ключ — его выдаёт администратор сервиса (веб-панель: Настройки → API-ключи).\n\nКлюч передаётся в заголовке X-API-Key и нужен для всех запросов, кроме health, marketplaces и parse/detect. Без ключа — 401, с неверным или отозванным — 403.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Root",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        }
      }
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "health"
          ]
        }
      }
    },
    {
      "name": "Marketplaces",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/marketplaces",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "marketplaces"
          ]
        }
      }
    },
    {
      "name": "Detect marketplace",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/parse/detect?url={{productUrl}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "parse",
            "detect"
          ],
          "query": [
            {
              "key": "url",
              "value": "{{productUrl}}"
            }
          ]
        }
      }
    },
    {
      "name": "Parse product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/parse",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "parse"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"{{productUrl}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Парсинг одной карточки, результат сразу в ответе."
      }
    },
    {
      "name": "Parse batch",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/parse/batch",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "parse",
            "batch"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"urls\": [\n    \"{{productUrl}}\"\n  ],\n  \"concurrency\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "1–100 ссылок, ответ после обработки всех. concurrency: null → значение по умолчанию сервера. Для больших списков используйте Jobs."
      }
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "jobs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"urls\": [\n    \"{{productUrl}}\"\n  ],\n  \"concurrency\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "1–1000 ссылок. Отвечает сразу (202) и парсит в фоне. id задачи сохраняется в переменную jobId. Не больше 5 незавершённых задач на ключ, иначе 429."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 202) pm.collectionVariables.set('jobId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get job",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "jobs",
                "{{jobId}}"
              ]
            },
            "description": "Статус (pending → running → completed / failed), прогресс done/total и результаты готовых ссылок в порядке запроса. Опрашивайте, пока status не станет completed или failed."
          }
        },
        {
          "name": "List jobs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "jobs"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Последние задачи этого ключа, без результатов."
          }
        }
      ],
      "description": "Фоновый парсинг больших списков ссылок."
    },
    {
      "name": "Monitors",
      "item": [
        {
          "name": "Create monitor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/monitors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "monitors"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{productUrl}}\",\n  \"interval_seconds\": null,\n  \"name\": \"Мой товар\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Начать отслеживать цену. Первая проверка — сразу. interval_seconds: null → значение сервера по умолчанию. id сохраняется в переменную monitorId. Повтор той же ссылки — 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('monitorId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List monitors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/monitors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "monitors"
              ]
            },
            "description": "Все мониторы ключа с последней ценой и статусом проверки."
          }
        },
        {
          "name": "Get monitor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/monitors/{{monitorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "monitors",
                "{{monitorId}}"
              ]
            }
          }
        },
        {
          "name": "Pause monitor",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/monitors/{{monitorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "monitors",
                "{{monitorId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Меняются только переданные поля: active, interval_seconds (null — по умолчанию), name."
          }
        },
        {
          "name": "Resume monitor",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/monitors/{{monitorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "monitors",
                "{{monitorId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Price history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/monitors/{{monitorId}}/history?limit=500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "monitors",
                "{{monitorId}}",
                "history"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "500"
                }
              ]
            },
            "description": "Точки цены от старых к новым."
          }
        },
        {
          "name": "Delete monitor",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/monitors/{{monitorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "monitors",
                "{{monitorId}}"
              ]
            },
            "description": "Удаляет монитор вместе с историей цен. Ответ 204."
          }
        },
        {
          "name": "Alerts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/alerts?limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "alerts"
              ],
              "query": [
                {
                  "key": "since",
                  "value": "2026-01-01T00:00:00Z",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": "Изменения цен по мониторам ключа, новые сверху. since — вернуть только события после этого момента."
          }
        }
      ],
      "description": "Отслеживание цен товаров."
    }
  ],
  "variable": [
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "monitorId",
      "value": ""
    }
  ]
}
